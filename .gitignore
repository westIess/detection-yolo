# ============================================================
# .gitignore для проекта PPE Detection (YOLO11)
# ============================================================

# --- Датасет (скачивается отдельно, ~178 МБ) ---
datasets/
*.zip
*.rar
*.tar.gz

# --- Результаты обучения ---
# Открываем путь к нужной модели через исключения
/runs/*
!/runs/detect/
/runs/detect/*
!/runs/detect/train-16/
/runs/detect/train-16/*
!/runs/detect/train-16/weights/
/runs/detect/train-16/weights/*
!/runs/detect/train-16/weights/best.pt
!/runs/detect/train-16/results.csv
!/runs/detect/train-16/results.png
!/runs/detect/train-16/confusion_matrix.png
!/runs/detect/train-16/args.yaml

# --- Предобученные веса (скачиваются автоматически) ---
*.pt
yolo11n.pt
yolo11s.pt
yolo11m.pt
yolo11l.pt
yolo11x.pt
yolov8*.pt
weights/

# --- ONNX и другие экспорты ---
*.onnx
*.engine
*.tflite
*.torchscript

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
.venv/
env/
ENV/

# --- Jupyter и кэш ---
.ipynb_checkpoints/
*.ipynb_checkpoints
*.cache
*.jpg.cache
*.jpeg.cache
*.png.cache
*.txt.cache

# --- IDE ---
.vscode/
.vs/
.idea/
*.swp
*.swo
*~

# --- OS ---
Thumbs.db
.DS_Store
desktop.ini

# --- Логи и временные файлы ---
*.log
logs/
tmp/
temp/
*.tmp

# --- Секреты ---
.env
.env.*
!.env.example
secrets.json
api_keys.txt
screenshots/violations/
